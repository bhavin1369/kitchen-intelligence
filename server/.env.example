# ==============================================================================
# Kitchen Intelligence Engine - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values before running in production.

# Flask Application Settings
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Security Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-32-char-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-signing-key-32-chars
JWT_EXPIRATION_HOURS=24
STRICT_AUTH=0

# Database Configuration
# Default: High-concurrency SQLite with WAL mode enabled
DATABASE_PATH=instance/kitchen_intelligence.db

# Alternative: PostgreSQL Production URL
# DATABASE_URL=postgresql://kitchen_user:StrongPassword123@localhost:5432/kitchen_intelligence_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
