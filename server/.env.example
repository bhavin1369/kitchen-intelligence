# Kitchen Intelligence System — Environment Configuration
FLASK_APP=run.py
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# Security Keys
SECRET_KEY=kitchen-intel-super-secret-key-production-grade-2026
JWT_SECRET_KEY=kitchen-intel-super-secret-jwt-key-32-chars-long-2026
JWT_EXPIRATION_HOURS=24

# Database Configuration
DATABASE_URL=sqlite:///instance/kitchen_intelligence.db
DATABASE_PATH=instance/kitchen_intelligence.db

# Frontend CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

